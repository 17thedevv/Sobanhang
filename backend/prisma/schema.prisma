// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?
  status       String   @default("NEW") // NEW, REGISTERING, SHOP_CREATED, PASSWORD_NOT_SET, ACTIVE
  role         String   @default("OWNER")
  createdAt    DateTime @default(now())

  store             Store?
  oauthAccounts     OAuthAccount[]
  onboardingSession OnboardingSession?
}

model Store {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  name      String
  industry  String
  createdAt DateTime @default(now())

  owner      User       @relation(fields: [ownerId], references: [id])
  products   Product[]
  orders     Order[]
  categories Category[]
  customers  Customer[]
  customerGroups CustomerGroup[]
  customerTags   CustomerTag[]
  cashSources CashSource[]
  settings         String? // JSON string for store settings
  debtTransactions DebtTransaction[]
  debtReminders    DebtReminder[]
}

model Category {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id])
  products Product[]
}

model Product {
  id               String   @id @default(uuid())
  storeId          String
  categoryId       String?
  name             String
  price            Float
  promotionalPrice Float?
  wholesalePrice   String? // JSON string for tiers
  trackInventory   Boolean  @default(true)
  stock            Int      @default(0)
  unit             String
  barcode          String?
  imageUrl         String?
  upsellIds        String? // JSON string array of product IDs
  showOnWeb        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store      Store            @relation(fields: [storeId], references: [id])
  category   Category?        @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  orderItems OrderItem[]
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  attributes String // JSON string e.g. {"Màu sắc": "Đỏ", "Size": "XL"}
  price      Float? // Override base price if set
  stock      Int     @default(0)
  barcode    String?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model Customer {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  phone     String?
  address   String?
  note      String?
  avatarUrl String?
  email     String?
  isSupplier Boolean @default(false)
  birthday  DateTime?
  gender    String?   // "MALE", "FEMALE", "OTHER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store   @relation(fields: [storeId], references: [id])
  orders           Order[]
  debtTransactions DebtTransaction[]
  debtReminders    DebtReminder[]

  groups           CustomerGroup[]
  tags             CustomerTag[]
  invoiceInfo      InvoiceInfo?
  notes            CustomerNote[]
}

model CustomerGroup {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())

  store     Store      @relation(fields: [storeId], references: [id])
  customers Customer[]
}

model CustomerTag {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  createdAt DateTime @default(now())

  store     Store      @relation(fields: [storeId], references: [id])
  customers Customer[]
}

model InvoiceInfo {
  id           String   @id @default(uuid())
  customerId   String   @unique
  type         String   // "INDIVIDUAL", "COMPANY"
  buyerName    String?
  taxCode      String?
  idCard       String?
  address      String?
  contactEmail String?
  contactPhone String?
  bankName     String?
  bankAccount  String?

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  content    String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Order {
  id                String   @id @default(uuid())
  storeId           String
  customerId        String?
  total             Float
  discount          Float    @default(0)
  shippingFee       Float    @default(0)
  orderStatus       String   @default("COMPLETED") // DRAFT, CONFIRMED, COMPLETED, CANCELLED
  paymentStatus     String   @default("PAID") // UNPAID, PAID, DEBT
  fulfillmentStatus String   @default("DELIVERED") // NONE, PENDING_DELIVERY, DELIVERED
  cashSourceId      String?
  createdAt         DateTime @default(now())

  store      Store       @relation(fields: [storeId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  cashSource CashSource? @relation(fields: [cashSourceId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  productId           String
  variantId           String?
  productNameSnapshot String
  unitPrice           Float
  quantity            Int
  subtotal            Float

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model OnboardingSession {
  id                   String  @id @default(uuid())
  userId               String  @unique
  needs                String? // JSON string
  surveyAnswers        String? // JSON string
  onboardingPreference String?
  status               String  @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED

  user User @relation(fields: [userId], references: [id])
}

model OtpVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  purpose    String // e.g., "REGISTER", "FORGOT_PASSWORD"
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
}

model OAuthAccount {
  id             String @id @default(uuid())
  userId         String
  provider       String // e.g., "GOOGLE"
  providerUserId String

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
}

model CashSource {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  type      String   @default("CASH") // CASH, BANK, EWALLET
  balance   Float    @default(0)
  isDefault Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id])
  orders           Order[]
  transactions     CashTransaction[]
  debtTransactions DebtTransaction[]
}

model CashTransaction {
  id           String   @id @default(uuid())
  cashSourceId String
  amount       Float
  type         String // IN, OUT
  referenceId  String? // Order ID or other ref
  description  String?
  createdAt    DateTime @default(now())

  cashSource CashSource @relation(fields: [cashSourceId], references: [id])
}

model DebtTransaction {
  id             String      @id @default(uuid())
  storeId        String
  customerId     String
  direction      String      // "GAVE" (Tôi đã đưa = Phải thu) | "RECEIVED" (Tôi đã nhận = Phải trả)
  amount         Float
  balance        Float       // Dư nợ sau giao dịch này
  cashSourceId   String?
  note           String?
  transactionDate DateTime   @default(now())
  attachments    String?     // JSON array of file URLs
  parentId       String?     // Liên kết với giao dịch nợ gốc (cho thanh toán)
  type           String      @default("DEBT") // "DEBT" | "PAYMENT"
  createdAt      DateTime    @default(now())

  store      Store      @relation(fields: [storeId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  cashSource CashSource? @relation(fields: [cashSourceId], references: [id])
  parent     DebtTransaction?  @relation("DebtPaymentLink", fields: [parentId], references: [id])
  children   DebtTransaction[] @relation("DebtPaymentLink")
}

model DebtReminder {
  id           String   @id @default(uuid())
  storeId      String
  customerId   String
  reminderDate DateTime
  status       String   @default("PENDING") // "PENDING" | "SENT" | "OVERDUE"
  createdAt    DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
}
